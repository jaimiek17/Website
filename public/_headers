# Header rules for Cloudflare Pages. Mirrors what netlify.toml did.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Short cache. The version query on the link is what makes a change land
# immediately; this stops a stale copy sticking around for a week if I forget.
/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# The oracle deck web app. Her own file, served as it is. The cards never
# change once published, so they cache for a year. The app shell and the
# service worker must not, or an update would never reach a phone that has
# already installed it.
/narrative-loom/app/cards/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex

/narrative-loom/app/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex
