# Header rules for Cloudflare Pages. Mirrors what netlify.toml did.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Short cache. The version query on the link is what makes a change land
# immediately; this stops a stale copy sticking around for a week if I forget.
/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# The oracle deck web app. Her own files, served as they are, and a
# deliverable rather than a landing page, so nothing here is indexed.
#
# The shell files are listed one by one on purpose. A /narrative-loom/app/*
# wildcard also matches the cards, and Cloudflare applies every rule that
# matches and joins the results, which produced a Cache-Control reading
# max-age=0 and max-age=31536000 at the same time.
/narrative-loom/app/*
  X-Robots-Tag: noindex

# The cards never change once published.
/narrative-loom/app/cards/*
  Cache-Control: public, max-age=31536000, immutable

# These must not stick, or an update would never reach a phone that has
# already added the app to its home screen.
/narrative-loom/app/
  Cache-Control: public, max-age=0, must-revalidate

/narrative-loom/app/index.html
  Cache-Control: public, max-age=0, must-revalidate

/narrative-loom/app/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/narrative-loom/app/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

/narrative-loom/app/icon-180.png
  Cache-Control: public, max-age=0, must-revalidate
